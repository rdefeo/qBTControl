{
  "manifest_version": 3,
  "name": "qBTControl",
  "version": "1.0.0",
  "description": "Send torrents and magnet links to your qBittorrent server.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open qBittorrent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
